# ==========================================
# SCRAPSAATHI ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api

# Database Configuration (MongoDB / DocumentDB)
DATABASE_URL=mongodb://localhost:27017/scrapsaathi

# Security & Sessions
JWT_SECRET=scrapsaathi_super_secure_jwt_secret_dev_2026_change_in_prod
SESSION_SECRET=scrapsaathi_session_secret_dev_2026
BCRYPT_SALT_ROUNDS=10

# OAuth Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# File & Media Storage (S3 / Cloudinary / Local)
STORAGE_PROVIDER=local # Options: local, s3, cloudinary
STORAGE_BUCKET=scrapsaathi-lots-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# External AI Vision Service (Optional FastAPI/PyTorch Microservice)
AI_SERVICE_URL=http://localhost:8000/api/v1/classify-scrap
USE_MOCK_AI_PROVIDER=true
